Cell[BoxData[{
 RowBox[{
  RowBox[{"cen", "=", 
   RowBox[{"{", 
    RowBox[{
    "2.5", ",", "7.5", ",", "15", ",", "25", ",", "35", ",", "50", ",", 
     "70"}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"mub", "=", 
   RowBox[{"{", 
    RowBox[{
    "399.8", ",", "395.6", ",", "391.6", ",", "382.4", ",", "376.1", ",", 
     "357.8", ",", "337.8"}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"data", "=", 
   RowBox[{"Transpose", "[", 
    RowBox[{"{", 
     RowBox[{"cen", ",", "mub"}], "}"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"para1", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"a", " ", "x"}], "+", "b"}], "/.", 
    RowBox[{"FindFit", "[", 
     RowBox[{"data", ",", 
      RowBox[{
       RowBox[{"a", " ", "x"}], "+", "b"}], ",", 
      RowBox[{"{", 
       RowBox[{"a", ",", "b"}], "}"}], ",", "x"}], "]"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"fun1", "[", "x_", "]"}], "=", "para1"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"para2", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"c", " ", 
      SuperscriptBox["x", "2"]}], "+", 
     RowBox[{"a", " ", "x"}], "+", "b"}], "/.", 
    RowBox[{"FindFit", "[", 
     RowBox[{"data", ",", 
      RowBox[{
       RowBox[{"c", " ", 
        SuperscriptBox["x", "2"]}], "+", 
       RowBox[{"a", " ", "x"}], "+", "b"}], ",", 
      RowBox[{"{", 
       RowBox[{"a", ",", "b", ",", "c"}], "}"}], ",", "x"}], "]"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"fun2", "[", "x_", "]"}], "=", "para2"}], ";"}]}], "Input",
 CellChangeTimes->{{3.9680394038456497`*^9, 3.9680394807902737`*^9}, {
  3.968039510829647*^9, 3.9680396133694305`*^9}, {3.968039645156765*^9, 
